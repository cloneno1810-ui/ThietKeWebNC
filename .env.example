# Cau hinh may chu
PORT=8080
NODE_ENV=development

# Chuoi ket noi PostgreSQL (Neon / Supabase / Local)
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require

# Khoa bi mat cho phien va JWT (BM7, BM11)
SESSION_SECRET=thay-bang-chuoi-ngau-nhien-64-ky-tu-khi-trien-khai
JWT_SECRET=thay-bang-chuoi-ngau-nhien-64-ky-tu-khi-trien-khai
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# Gioi han tan suat dang nhap (BM10)
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=900000

# Thoi han giữ cho (phut)(BM12);
HOLD_DURATION_MINUTES=30

# Buoi 08: APP_ORIGIN phai la HTTPS khi NODE_ENV=production, khong co / cuoi.
APP_ORIGIN=http://localhost:8080
# Tren Render: APP_ORIGIN=https://bookingh.onrender.com (khong them /login.html).
# Khi bo APP_ORIGIN, ma nguon dung RENDER_EXTERNAL_URL do Render cap.
ALLOWED_ORIGINS=
# Render: 1; local: 0. Khong tin header proxy tren may local.
TRUST_PROXY_HOPS=0
